FROM node@sha256:713cfbf4a0ac19f40e1bb9919893e126b74a5c8cf5d0623c9f89515c8f74c6fa
WORKDIR /app
COPY infra/r1/queue/package*.json ./
RUN npm ci --omit=dev
COPY src/queue-worker.mjs ./queue-worker.mjs
COPY src/research-tools.mjs ./research-tools.mjs
COPY src/sandbox-adapter.mjs ./sandbox-adapter.mjs
COPY src/sandbox-opensandbox.mjs ./sandbox-opensandbox.mjs
USER node
CMD ["node", "/app/queue-worker.mjs"]
