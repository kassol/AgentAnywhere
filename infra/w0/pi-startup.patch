+import { describe, expect, it } from 'bun:test'
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { PiAgent } from '../pi-agent.ts'
+import type { BackendConfig } from '../backend/types.ts'
+
+describe('PiAgent startup failure', () => {
+  for (const failure of ['early exit', 'missing executable'] as const) {
+    it(`rejects mini completion promptly on ${failure}`, async () => {
+      const root = mkdtempSync(join(tmpdir(), 'pi-startup-'))
+      const script = join(root, 'exit.cjs')
+      writeFileSync(script, `
+        process.stdin.once('data', () => {
+          require('node:fs').writeSync(2, 'startup fixture failed\\n');
+          process.exit(17);
+        });
+      `)
+      const config: BackendConfig = {
+        provider: 'pi',
+        workspace: { id: 'test', name: 'Test', slug: 'test', rootPath: root, createdAt: 0 },
+        isHeadless: true,
+        runtime: {
+          paths: { node: failure === 'early exit' ? process.execPath : join(root, 'missing-runtime'), piServer: script },
+          // Avoid reading ambient provider credentials; this test never calls a model.
+          customEndpoint: { api: 'openai-completions' },
+        },
+      }
+      const agent = new PiAgent(config)
+      let timer: ReturnType<typeof setTimeout> | undefined
+      try {
+        const result = Promise.race([
+          agent.runMiniCompletion('unused'),
+          new Promise<never>((_, reject) => {
+            timer = setTimeout(() => reject(new Error('startup rejection deadline exceeded')), 1500)
+          }),
+        ])
+        await expect(result).rejects.toThrow(failure === 'early exit' ? 'code=17' : 'ENOENT')
+        if (failure === 'early exit') {
+          expect(agent.getRecentStderr()).toContain('startup fixture failed')
+        }
+      } finally {
+        clearTimeout(timer)
+        agent.destroy()
+        rmSync(root, { recursive: true, force: true })
+      }
+    })
+  }
+})
