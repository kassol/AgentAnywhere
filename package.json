{
  "name": "agentanywhere",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun src/server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun src/server.ts",
    "prototype:r3": "vite --host 127.0.0.1 --port 19120 --strictPort --open /?prototype=r3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.2",
    "typescript": "5.9.3",
    "vite": "6.2.4"
  }
}
